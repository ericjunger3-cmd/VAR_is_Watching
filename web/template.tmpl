<script>
    // While the game loads, Gianno Infantini (the TV expert from the game)
    // says something cheeky. A new line every 3 seconds.
    const QUOTES = [
        "Loading... slower than a VAR check.",
        "Grab a snack, rookie. This takes a while.",
        "In my day we just trusted the referee.",
        "Clearly offside. I have not even seen it yet.",
        "Downloading the stadium. All 60,000 seats.",
        "Do not touch any cables while you wait. No reason.",
        "A bear as the mascot? Unbelievable. Absolutely unbelievable.",
    ];
    let quoteNumber = 0;
    function nextQuote() {
        const quote = document.getElementById("quote");
        quote.innerHTML = "<b>GIANNO INFANTINI:</b><br>" + QUOTES[quoteNumber % QUOTES.length];
        quoteNumber = quoteNumber + 1;
    }
    nextQuote();
    setInterval(nextQuote, 3000);
</script>

